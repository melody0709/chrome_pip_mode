{
  "manifest_version": 3,
  "name": "Floating Video Resizer",
  "version": "1.1.0",
  "description": "Four-corner resize and drag for Bilibili and YouTube's floating player, plus a customizable hotkey for Bilibili web fullscreen.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Floating Video Resizer",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage"],
  "host_permissions": [
    "https://www.bilibili.com/*",
    "https://www.youtube.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://www.bilibili.com/video/*",
        "*://www.bilibili.com/bangumi/play/*",
        "*://www.bilibili.com/cheese/play/*",
        "*://www.bilibili.com/festival/*",
        "*://www.bilibili.com/list/*",
        "*://www.bilibili.com/medialist/play/*"
      ],
      "js": ["hotkey.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.bilibili.com/video/*",
        "https://www.bilibili.com/bangumi/play/*",
        "https://www.youtube.com/watch?*",
        "https://www.youtube.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
